{
  "expo": {
    "name": "Appsurge",
    "slug": "appsurge-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./appsurgeicon-fullbleed.png",
    "scheme": "appsurge",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appsurge",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "CFBundleDisplayName": "Appsurge",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.appsurge",
            "CFBundleURLSchemes": [
              "appsurge"
            ]
          },
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.745082372444-dv2e4abdk5tcri9peg2hlc2agt48hh1k",
              "com.googleusercontent.apps.745082372444-hic833u61q1nk8dn25f46mptifepj060"
            ]
          }
        ]
      },
      "icon": "./appsurgeicon-fullbleed.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./appsurgeicon-fullbleed.png",
        "backgroundColor": "#2B2B2B"
      },
      "package": "com.appsurge",
      "versionCode": 2
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./appsurgeicon-fullbleed.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      [
        "expo-web-browser",
        {
          "appName": "appsurge"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "58b50c42-a412-43d9-b8cc-7a0849040024"
      }
    },
    "owner": "tristansouza2"
  }
}
