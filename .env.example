# Copy to .env and fill in. Firebase web config is public (shipped in web builds);
# the gateway key is the same revocable key the desktop app uses.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=app-surge
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_API_URL=https://api.app-surge.dev
EXPO_PUBLIC_GATEWAY_URL=
EXPO_PUBLIC_GATEWAY_API_KEY=
EXPO_PUBLIC_LAUNCHPAD_ORIGIN=https://app-surge.dev

# Optional iOS-specific Google OAuth client. Falls back to the web client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=745082372444-hic833u61q1nk8dn25f46mptifepj060.apps.googleusercontent.com

# Product analytics (Mixpanel project token — empty/absent disables tracking)
EXPO_PUBLIC_MIXPANEL_TOKEN=
