    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.24",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.6.0",
